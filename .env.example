# Copy this file to .env and fill it. .env is never committed.

# Optional. A free Socrata app token raises the API rate limit.
# Get one at https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Where the data lake lives (raw/, silver/, ...). Ignored by Git.
SECOP_DATA_DIR=data

# The slice: contracts signed on or after this date.
SECOP_SLICE_START=2025-01-01

# Rows per API request.
SECOP_PAGE_SIZE=25000

# Alerts with ntfy (https://ntfy.sh): install the ntfy app and subscribe to this topic.
# The topic works as a password: make it random and never commit it. Empty = alerts off.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Optional: ntfy also sends every alert to this email address.
ALERT_EMAIL=
# Needed for ALERT_EMAIL on ntfy.sh: a free account with a verified email -> Account -> Access tokens.
# The token gives full access to the ntfy account: keep it only here.
NTFY_TOKEN=

# Heartbeat (dead man's switch): healthchecks.io alerts when the daily run does NOT report.
# Free account -> new check -> copy its ping URL (https://hc-ping.com/<uuid>). Empty = off.
HC_PING_URL=

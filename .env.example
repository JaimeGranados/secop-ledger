# Copy this file to .env and fill it. .env is never committed.

# Optional. A free Socrata app token raises the API rate limit.
# Get one at https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Where the data lake lives (raw/, silver/, ...). Ignored by Git.
SECOP_DATA_DIR=data

# The slice: contracts signed on or after this date.
SECOP_SLICE_START=2025-01-01

# Rows per API request.
SECOP_PAGE_SIZE=25000
